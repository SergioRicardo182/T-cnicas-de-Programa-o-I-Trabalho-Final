        "tabela_renda = pd.crosstab(df_limpo[\"Income_Category\"], df_limpo[\"Status\"], normalize=\"index\") * 100\n",
        "print(tabela_renda.round(1))\n",
        "\n",
        "# Gráfico\n",
        "sns.countplot(data=df_limpo, x=\"Income_Category\", hue=\"Status\")\n",
        "plt.title(\"Quantidade de Clientes Ativos vs Cancelados por Renda\")\n",
        "plt.xlabel(\"Faixa de Renda Anual\")\n",
        "plt.ylabel(\"Quantidade de Clientes\")\n",
        "plt.xticks(rotation=45)\n",
